# Fill in local endpoints/keys before running commands that call model APIs.

# For Eval-Skill: provide JUDGE_MODEL, EXTRACTION_MODEL, and SUPER_JUDGE_MODEL_NAME (typically the same as EXTRACTION_MODEL).
# For vanilla baseline: provide JUDGE_MODEL.
# For rubric-based baseline: provide JUDGE_MODEL and RUBRIC_MODEL_NAME.

# Judge model, used for vanilla/rubric/skill evaluation.
JUDGE_MODEL_NAME=Qwen3-8B
JUDGE_API_BASE=http://localhost:8000/v1
JUDGE_API_KEY=EMPTY
JUDGE_THINK=false

# Extraction model, used for explanations, intent/guideline extraction, and skill synthesis.
EXTRACTION_MODEL_NAME=deepseek-v4-flash
EXTRACTION_API_BASE=https://api.deepseek.com
EXTRACTION_API_KEY=EMPTY
EXTRACTION_THINK=true

# Rubric model, used by rubric-based evaluation.
RUBRIC_MODEL_NAME=Qwen3-8B
RUBRIC_API_BASE=http://localhost:8000/v1
RUBRIC_API_KEY=EMPTY
RUBRIC_THINK=false

# Super judge, used by the first round of the stage 1 of the skill pipeline
SUPER_JUDGE_MODEL_NAME=deepseek-v4-flash
SUPER_JUDGE_API_BASE=https://api.deepseek.com
SUPER_JUDGE_API_KEY=EMPTY
SUPER_JUDGE_THINK=true

# Candidate generation model, used by Best-of-N and HealthBench pair construction.
# GENERATION_MODEL_NAME=Qwen3-8B
# GENERATION_API_BASE=http://localhost:8000/v1
# GENERATION_API_KEY=EMPTY
# GENERATION_THINK=false

# Final judge, used to score each generated response against the
# official rubric items while constructing preference pairs.
# FJ_MODEL_NAME=deepseek-v4-pro
# FJ_API_BASE=http://localhost:8000/v1
# FJ_API_KEY=EMPTY
# FJ_THINK=true
